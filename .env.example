# 필수
ONSTAGE_URL=https://on-stage-nine.vercel.app
OPENAI_API_KEY=

# 선택 (기본값)
ALLOWED_ORIGINS=http://localhost:3000
# 배포 연동 시 on-stage 도메인을 추가 (와일드카드 * 는 금지):
# ALLOWED_ORIGINS=http://localhost:3000,https://on-stage-nine.vercel.app
# 프리뷰 도메인 패턴
# ALLOWED_ORIGIN_REGEX=
OPENAI_MODEL=gpt-4.1-mini
TRUSTED_PROXY_HOPS=1
RATE_PER_MINUTE=5
RATE_PER_IP_DAILY=30
GLOBAL_DAILY=1000
# 트레이싱은 기본 꺼짐. 로컬 스파이크에서만 true
TRACING_ENABLED=false
