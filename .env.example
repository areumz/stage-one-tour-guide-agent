# 필수 / Required
ONSTAGE_URL=https://on-stage-nine.vercel.app
OPENAI_API_KEY=

# 허용 Origin / CORS (와일드카드 * 는 금지 / wildcard is rejected)
# 운영: Origin 은 끝에 / 가 없는 형태여야 한다 (예: https://on-stage-nine.vercel.app)
ALLOWED_ORIGINS=http://localhost:3000
# 배포 연동 시 on-stage 도메인을 추가:
# ALLOWED_ORIGINS=http://localhost:3000,https://on-stage-nine.vercel.app
# 프리뷰 도메인 패턴
# ALLOWED_ORIGIN_REGEX=

# 모델 / Models
OPENAI_MODEL=gpt-4.1-mini
CLASSIFIER_MODEL=gpt-4.1-mini
# 비우면 모델 기본값. 모델이 temperature 를 지원할 때만 설정
# OPENAI_TEMPERATURE=

# 한도 / Limits (초기값, 선불 크레딧 잔액이 최종 상한)
TRUSTED_PROXY_HOPS=1
RATE_PER_MINUTE=5
RATE_PER_IP_DAILY=30
GLOBAL_DAILY=1000

# 세션 / Sessions (서버 메모리, 재시작 시 사라짐)
SESSION_TTL_SECONDS=1800
SESSION_MAX=500
HISTORY_TURNS=6
SESSION_TURN_LIMIT=20

# 트레이싱은 기본 꺼짐. 로컬 스파이크에서만 true
TRACING_ENABLED=false
